<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_qtj_bmb_jk" xml:lang="ar">
  <title>واجهة طباعة API</title>
  <prolog>
    <metadata>
      <audience experiencelevel="Developers"/>
      <category>API</category>
    </metadata>
  </prolog>
  <refbody>
    <refsyn><apiname>PrintDoc(FileName,PrintSettings)</apiname></refsyn>
    <properties>
      <property>
        <proptype>المُعطى</proptype>
        <propdesc>الوصف</propdesc>
      </property>
      <property>
        <proptype><parmname>FileName</parmname></proptype>
        <propdesc>يحدد المسار الكامل، بما في ذلك اسم الملف، للمستند الذي ترغب في طباعته.</propdesc>
      </property>
      <property>
        <proptype><parmname>PrintSettings</parmname></proptype>
        <propdesc>يمثل مصفوفة مفصولة بفواصل تتضمن الإعدادات التالية:
          <ul id="ul_ymh_k4b_jk">
            <li>اسم الطابعة (PrinterName)</li>
            <li>عدد النسخ (NumberOfCopies)</li>
            <li>اتجاه الصفحة (PageOrientation)</li>
            <li>التحجيم (Scaling)</li>
          </ul>
        </propdesc>
      </property>
    </properties>
  </refbody>
</reference>
